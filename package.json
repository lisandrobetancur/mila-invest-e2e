{
  "name": "mila-invest-ui-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Suite end-to-end black-box de MILA Invest (Playwright + Serenity/JS Screenplay)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:web:movil": "playwright test --project=web-movil",
    "test:web:escritorio": "playwright test --project=web-escritorio",
    "test:android": "wdio run mobile/wdio.conf.ts",
    "test:android:smoke": "wdio run mobile/wdio.conf.ts --mochaOpts.grep @smoke",
    "ids:sync": "tsx scripts/sync-ids.ts",
    "ids:check": "tsx scripts/sync-ids.ts --check",
    "report:web": "html-reporter serve --dir ./reports/serenity-js --host 127.0.0.1 --open",
    "report:android": "html-reporter serve --dir ./reports/serenity-js-mobile --host 127.0.0.1 --open",
    "clean": "rimraf reports playwright-report test-results",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:android": "tsc --noEmit -p mobile/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@serenity-js/assertions": "3.49.0",
    "@serenity-js/console-reporter": "3.49.0",
    "@serenity-js/core": "3.49.0",
    "@serenity-js/html-reporter": "3.49.0",
    "@serenity-js/mocha": "3.49.0",
    "@serenity-js/playwright": "3.49.0",
    "@serenity-js/playwright-test": "3.49.0",
    "@serenity-js/web": "3.49.0",
    "@serenity-js/webdriverio": "3.49.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@wdio/appium-service": "9.33.1",
    "@wdio/cli": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "appium": "4.0.0",
    "appium-uiautomator2-driver": "9.2.2",
    "eslint": "10.15.0",
    "mocha": "12.0.3",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "webdriverio": "9.33.1"
  }
}
